# Machine/compiler fragment: macOS, GNU gfortran (Homebrew).

FC = gfortran

FFLAGS = -ffree-line-length-none -I$(objdir) -J$(objdir)
FFLAGS_OPENMP = -fopenmp

DFLAGS_NODEBUG = -O3 -mcpu=native
DFLAGS_DEBUG   = -O0 -g -fbacktrace -fcheck=all -ffpe-trap=invalid,zero,overflow -Wall
DFLAGS_PROFILE = -O2 -pg

# Apple ld rejects -Wl,-zmuldefs; nothing extra is needed here.
LFLAGS_EXTRA =
